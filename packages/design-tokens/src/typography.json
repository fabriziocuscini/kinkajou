{
  "size": {
    "2xs": {
      "$type": "fontSizes",
      "$value": "10"
    },
    "xs": {
      "$type": "fontSizes",
      "$value": "12"
    },
    "sm": {
      "$type": "fontSizes",
      "$value": "14"
    },
    "md": {
      "$type": "fontSizes",
      "$value": "16"
    },
    "lg": {
      "$type": "fontSizes",
      "$value": "18"
    },
    "2xl": {
      "$type": "fontSizes",
      "$value": "20"
    },
    "3xl": {
      "$type": "fontSizes",
      "$value": "24"
    },
    "4xl": {
      "$type": "fontSizes",
      "$value": "28"
    },
    "5xl": {
      "$type": "fontSizes",
      "$value": "36"
    },
    "6xl": {
      "$type": "fontSizes",
      "$value": "48"
    }
  },
  "fontFamily": {
    "body": {
      "$type": "fontFamilies",
      "$value": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif"
    },
    "heading": {
      "$type": "fontFamilies",
      "$value": "{fontFamily.body}"
    },
    "mono": {
      "$type": "fontFamilies",
      "$value": "SFMono-Regular,Menlo,Monaco,Consolas,\"Liberation Mono\",\"Courier New\",monospace"
    }
  },
  "weight": {
    "light": {
      "$type": "fontWeights",
      "$value": "300"
    },
    "regular": {
      "$type": "fontWeights",
      "$value": "400"
    },
    "medium": {
      "$type": "fontWeights",
      "$value": "500"
    },
    "bold": {
      "$type": "fontWeights",
      "$value": "600"
    }
  },
  "lineHeight": {
    "shorter": {
      "$type": "lineHeights",
      "$value": "1.25"
    },
    "short": {
      "$type": "lineHeights",
      "$value": "1.375"
    },
    "moderate": {
      "$type": "lineHeights",
      "$value": "1.5"
    },
    "tall": {
      "$type": "lineHeights",
      "$value": "1.625"
    },
    "taller": {
      "$type": "lineHeights",
      "$value": "2"
    }
  },
  "letterSpacing": {
    "tight": {
      "$type": "letterSpacing",
      "$value": "-0.025em"
    },
    "tighter": {
      "$type": "letterSpacing",
      "$value": "-0.05em"
    },
    "wide": {
      "$type": "letterSpacing",
      "$value": "0.025em"
    },
    "wider": {
      "$type": "letterSpacing",
      "$value": "0.05em"
    }
  }
}